# Entity: historical

main: kit: entity: historical: {

  alias: field: {}

  fields: [
    {
      name: "clouds"
      req: false
      short: "Cloud coverage percentage"
      type: "`$INTEGER`"
    }
    {
      name: "date"
      req: false
      short: "Date of the historical data"
      type: "`$STRING`"
    }
    {
      name: "humidity"
      req: false
      short: "Humidity percentage"
      type: "`$INTEGER`"
    }
    {
      name: "precipitation"
      req: false
      short: "Precipitation amount"
      type: "`$NUMBER`"
    }
    {
      name: "pressure"
      req: false
      short: "Atmospheric pressure"
      type: "`$NUMBER`"
    }
    {
      name: "temperature"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "timestamp"
      req: false
      short: "Unix timestamp"
      type: "`$INTEGER`"
    }
    {
      name: "weather"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "wind_direction"
      req: false
      short: "Wind direction in degrees"
      type: "`$NUMBER`"
    }
    {
      name: "wind_speed"
      req: false
      short: "Wind speed"
      type: "`$NUMBER`"
    }
  ]

  name: "historical"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "city"
                orig: "city"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "end_date"
                orig: "end_date"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "en"
                kind: "query"
                name: "lang"
                orig: "lang"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "lat"
                orig: "lat"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "lon"
                orig: "lon"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "start_date"
                orig: "start_date"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "metric"
                kind: "query"
                name: "unit"
                orig: "unit"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/weather/historical"
          parts: [
            "weather"
            "historical"
          ]
          select: {
            exist: [
              "city"
              "end_date"
              "lang"
              "lat"
              "lon"
              "start_date"
              "unit"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.historical`"
          }
        }
      ]
    }
  }



}
